# aether-cms environment example
# Copy to `.env` and adjust. Never commit `.env`.

# HTTP port the server listens on (default 8080)
PORT=8080

# Secret used to sign auth cookies. Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=change-me-to-a-long-random-string

# Optional: tells LiteNode to serve frontend assets with long browser caching.
# Set to "production" when running behind nginx/pm2.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Built-in analytics (self-hosted first-party visit statistics)
# ---------------------------------------------------------------------------
# Enable/disable collection entirely (default: true).
ANALYTICS_ENABLED=true

# Where the JSONL detail logs + aggregated summary.json live.
# Default: <dataDir>/analytics  (i.e. content/data/analytics)
# ANALYTICS_DIR=

# Salt used to hash visitor IPs. Leave empty to auto-generate one at
# content/data/analytics/salt.txt (keep that file: changing it resets UV maths).
# ANALYTICS_SALT=

# Raw visit-log retention in days (older JSONL files are pruned automatically).
ANALYTICS_RETENTION_DAYS=180

# Trust X-Forwarded-For / X-Real-IP. Enable ONLY behind a reverse proxy
# (nginx/pm2 setups) — otherwise clients could spoof their IP.
ANALYTICS_TRUST_PROXY=false

# Skip visits from logged-in users (keeps your own browsing out of the stats).
ANALYTICS_EXCLUDE_ADMINS=true

# Ignore repeat views of the same page by the same visitor within N minutes.
ANALYTICS_DEDUP_MINUTES=30

# ---------------------------------------------------------------------------
# PeerTube integration (video covers / duration / channel, video library page)
# ---------------------------------------------------------------------------
# Base URL of your PeerTube instance. Used to build the PUBLIC thumbnail /
# watch / embed URLs that visitors' browsers load (the API may report http://
# URLs when the instance sits behind a reverse proxy — those are rebuilt).
PEERTUBE_URL=https://stream.dleu.net

# Optional: a separate base for SERVER-SIDE metadata fetching. Handy when the
# CMS host can only reach PeerTube on an internal address, e.g.
#   PEERTUBE_API_URL=http://10.0.0.12:9000     (docker published port)
# while PEERTUBE_URL stays the public HTTPS domain for visitors.
# Defaults to PEERTUBE_URL.
# PEERTUBE_API_URL=

# Disable metadata fetching entirely (embeds still work, covers fall back to a
# styled placeholder). Default: true.
PEERTUBE_ENABLED=true

# Where fetched metadata is cached — one JSON per video.
# Default: content/cache/peertube
# PEERTUBE_CACHE_DIR=

# Re-fetch metadata older than this many seconds (default: 24h).
PEERTUBE_CACHE_TTL=86400

# HTTP timeout for PeerTube API calls, in milliseconds.
PEERTUBE_TIMEOUT=8000

# How many videos to fetch per startup warm-up pass (default 200). Anything not
# covered here is fetched on demand when its page is visited.
# PEERTUBE_WARM_LIMIT=200

# Set to any value to log PeerTube fetch failures (silent by default).
# PEERTUBE_DEBUG=1

# ---------------------------------------------------------------------------
# Video autoplay + sequential playback (article pages)
# ---------------------------------------------------------------------------
# Every video on a page starts playing once it becomes visible, and the next
# one follows automatically when the current one ends. Browsers only allow
# programmatic playback while MUTED, so playback always starts muted; the
# on-page control bar offers "开声" (unmute at the current position), "下一个",
# "停止连播" and remembers each visitor's choice in localStorage.

# Default for "autoplay on page open". Set to false to keep it off by default —
# the control bar stays available, so a visitor can still turn it on for
# themselves (their choice is remembered per browser).
VIDEO_AUTOPLAY=true

# Start with sound instead of muted. Only works in browsers that already trust
# the site (i.e. the visitor interacted with it before); keep true for reliable
# autoplay everywhere.
VIDEO_AUTOPLAY_MUTED=true

# ---------------------------------------------------------------------------
# Site search (/search)
# ---------------------------------------------------------------------------
# How many results a search page shows before paginating.
# SEARCH_PER_PAGE=12

# ---------------------------------------------------------------------------
# Public read-only API + oEmbed (sharing & aggregation)
# ---------------------------------------------------------------------------
# /api/public/site, /api/public/posts, /api/public/posts/:slug, /oembed
# Only published content is exposed; CORS is open so other sites can consume it.
PUBLIC_API_ENABLED=true

# Requests per minute per IP for the public endpoints (0 = unlimited).
PUBLIC_API_RATE_LIMIT=120

# ---------------------------------------------------------------------------
# Tag suggestion backend (editor "推荐标签" button)
# ---------------------------------------------------------------------------
# Which backend to use: "ollama" (local LLM, best quality) or "jieba" (offline
# keyword extraction, free). If unset, it uses Ollama when OLLAMA_URL is set,
# otherwise jieba. If Ollama is unreachable/fails it falls back to jieba.
AI_BACKEND=

# Local Ollama server (used when AI_BACKEND=ollama, or auto when set).
OLLAMA_URL=http://127.0.0.1:11434
# Ollama model to use, e.g. qwen2.5:3b / qwen2.5:7b (smaller = faster on CPU).
OLLAMA_MODEL=qwen2.5:3b
# Max time (ms) to wait for Ollama to return before falling back to jieba.
AI_OLLAMA_TIMEOUT=90000
# llama.cpp threads per request. On big multi-NUMA CPU-only servers, FEWER
# threads (e.g. 4) is often much faster for small models. The OLLAMA_NUM_THREADS
# env is not honoured by every build, so this is sent per-request via options.
AI_OLLAMA_NUM_THREADS=4
