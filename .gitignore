# Static site folder
_site

# Editor folders
.vscode/

# Cache folder
/content/cache/

# User data
/content/data/

# Ignore everything in content/themes
content/themes/*

# But do not ignore the default folder
!content/themes/default

# Built-in custom theme shipped with this repo (ember)
!content/themes/ember

# User uploads
/content/uploads/

# Node modules
node_modules

# Environment Variables
.env

# Local npm cache used by offline installs
/.npm-cache/

# Release snapshots (build artifacts)
/release/

# Local deployment tooling — contains private server address / instance paths,
# so it stays on the operator's machine. Share a parameterised copy instead.
/tools/sync-today-to-server.ps1